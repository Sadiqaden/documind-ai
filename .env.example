# Copy to .env and fill in. NEVER commit .env.
# LLM provider: "anthropic" (Claude) or "extractive" (offline, no LLM; returns cited passages only)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=16000
# Server-side refusal fallback (beta). Set false if your account/platform rejects it.
ANTHROPIC_REFUSAL_FALLBACK=true

# Embeddings: "hash" (offline, lexical, no download) or "fastembed" (semantic; pip install fastembed; downloads model on first use)
EMBEDDING_PROVIDER=hash
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# Limits
MAX_UPLOAD_MB=25
MAX_PAGES=500
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=6
MIN_RELEVANCE=0.08
RATE_LIMIT_PER_MINUTE=30
AGENT_MAX_STEPS=5

# Public demo mode: preloads backend/demo_docs/*.pdf, disables upload/delete/re-index,
# tightens per-IP limits and caps total questions per day (protects your API bill).
DEMO_MODE=false
DEMO_RATE_LIMIT_PER_MINUTE=6
DEMO_DAILY_QUESTION_LIMIT=200
DEMO_MAX_QUESTION_CHARS=500
DEMO_AGENT_MAX_STEPS=3

DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
